<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <Description>In-memory object store that backs InMemoryBucket. No dependency on any cloud SDK.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InMemoryBucket" />
    <InternalsVisibleTo Include="InMemoryBucket.Tests" />
  </ItemGroup>

</Project>
